TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# polling for local development; webhook for Render
BOT_MODE=polling

# Required only when BOT_MODE=webhook
PUBLIC_BASE_URL=https://your-service.onrender.com
WEBHOOK_SECRET=replace-with-a-long-random-secret

# Render provides PORT automatically; 10000 is useful locally
PORT=10000
